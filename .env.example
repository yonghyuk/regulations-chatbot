# 사내 규정 RAG 챗봇 — 환경 변수 템플릿
# cp .env.example .env 후 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)

# ===== LLM =====
LLM_PROVIDER=gemini            # gemini 또는 openai
GOOGLE_API_KEY=                # Gemini 사용 시
OPENAI_API_KEY=                # OpenAI 사용 시
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# ===== 조직 정보 (비우면 범용 문구 표시) =====
COMPANY_NAME=
REGULATION_SCOPE=취업규칙

# ===== 다우오피스 로그인 인증 (필수) =====
DAOU_BASE_URL=https://<your-tenant>.daouoffice.com
DAOU_COMPANY_ID=
AUTH_SECRET=                   # 토큰 서명키. 예: openssl rand -hex 32
AUTH_ENABLED=true
AUTH_TOKEN_TTL_SECONDS=28800   # 8시간

# ===== 서버 =====
API_PORT=8085
VITE_DEV_PORT=5173

# ===== 비용 추정 (선택) =====
# MONTHLY_BUDGET_KRW=30000
# USD_TO_KRW=1380

# ===== LangSmith 트레이싱 (선택) =====
LANGSMITH_TRACING=false
LANGCHAIN_TRACING=false
# LANGSMITH_API_KEY=
